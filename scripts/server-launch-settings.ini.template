# Jarock local launch settings. This file is copied to server-launch-settings.ini.
# LOADER_TYPE is selected automatically on first start. Use fabric, neoforge or forge.
# Forge is currently unavailable for the official Minecraft 26.2 build and will show guidance.
LOADER_TYPE=none
# RAM values must use a JVM suffix such as G or M and leave at least 1G for Windows and other applications.
RAM_INITIAL=4G
RAM_MAX=4G
GUI_MODE=nogui
AUTO_CONFIGURE_JAVA=true
ONLINE_MODE=true
GC_PROFILE=default
# Set to false to hide the ASCII-art banner that is shown when the server finishes loading.
SHOW_READY_BANNER=true
# Startup update mode: install = check and install a verified update automatically;
# check = check only and never install; never = do not contact GitHub.
# The default is install. Choose check or never in parameter-manager.bat to override it.
AUTO_UPDATE_MODE=install
# World import: set this to the full path of a world folder (containing level.dat)
# or a .zip world archive to import it into the configured level-name at the next
# start. If the world already exists you are asked for confirmation and a backup is
# created first. WORLD_IMPORT_REMEMBER=true keeps the source for future starts and
# restores it only when the configured world folder is later deleted. With false,
# the source is cleared after the one-shot import.
WORLD_IMPORT_SOURCE=
WORLD_IMPORT_REMEMBER=false
# Internal state: do not edit manually; Jarock sets this after applying a remembered source.
WORLD_IMPORT_APPLIED=false
# World export: set this to a folder outside server/ to copy the current world there
# after every clean shutdown (the destination folder is overwritten).
WORLD_EXPORT_DEST=
# Release edition is stored separately in scripts/jarock-edition.ini; do not change it to switch packages manually.
# CLI/TUI and Full/Lite are preserved by the updater.
# Legacy AUTO_UPDATE_CHECK is still understood for older local settings:
# true maps to install and false maps to never when AUTO_UPDATE_MODE is absent.
