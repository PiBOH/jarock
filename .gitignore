# Jarock - Windows bootstrap for a modded Minecraft Java server
#
# Generated Minecraft runtime (everything the bootstrap downloads or the server writes)
/server/*
!/server/.gitkeep
!/server/README.md
!/server/icon.png
!/server/server-icon.png
!/server/server.properties.template
!/server/eula.txt.template
!/server/jarock-loader.txt.template
!/server/datapacks-manifest.ps1
!/server/mods-manifest.ps1
!/server/mods-manifest-neoforge.ps1
!/server/mods-manifest-26.3-fabric.ps1
!/server/mods-manifest-26.3-neoforge.ps1
/server/config/*
!/server/config/Geyser-Fabric/
/server/config/Geyser-Fabric/*
!/server/config/Geyser-Fabric/config.yml.template
!/server/config/Geyser-NeoForge/
/server/config/Geyser-NeoForge/*
!/server/config/Geyser-NeoForge/config.yml.template
!/server/config/welcomemessage.json5.jarock

# Local bootstrap and updater cache
/.cache/
/tui/node_modules/
/tui/dist/
/jarock-tui.exe

# Generated runtime data if a user changes the server directory
**/world/
**/world_nether/
**/world_the_end/
# World-import backups created automatically before a configured import replaces a world
**/world_originalbkp*/

**/logs/
**/crash-reports/
**/libraries/
**/fabric-server-launch.jar
**/vanilla-server.jar
**/neoforge-*-installer.jar
**/forge-*-installer.jar
**/server.properties
**/eula.txt
**/user_jvm_args.txt
**/run.bat
**/run.sh
**/java-path.txt
/scripts/java-home.txt
/java-home.txt

# Runtime secrets and local configuration
**/key.pem
**/*.pem
**/ops.json
**/whitelist.json
**/banned-players.json
**/banned-ips.json

# Agent-local tooling, scratch files and community skills
.agents/
.claude/
agent/
skills-lock.json
.ignore/

# Python cache (repository scripts)
__pycache__/
*.pyc

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Legacy local settings file, merged into scripts/jarock.ini and never tracked
/scripts/server-launch-settings.ini
