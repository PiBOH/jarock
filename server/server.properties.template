# Jarock server template for Fabric or NeoForge
# Copy this file to server/server.properties on first setup, then edit the values marked CONFIGURE.
# This template does not open router or firewall ports.

motd=§3>>> §6§lJa§9§lrock§r Minecraft 26.2 Server (stef) §r\nVisit §3piboh.github.io/jarock§r for more information.
level-name=world
gamemode=survival
difficulty=normal
hardcore=false
pvp=true
allow-flight=false
spawn-monsters=true
spawn-animals=true
spawn-npcs=true
max-players=20
view-distance=8
simulation-distance=6
online-mode=true
# The whitelist is DISABLED by default so the server can be tested easily.
# Before opening the server to the public, set white-list=true and enforce-whitelist=true,
# then add players from the console with: whitelist add PlayerName
white-list=false
enforce-whitelist=false
enforce-secure-profile=true
prevent-proxy-connections=false
server-port=25565
server-ip=
network-compression-threshold=256
sync-chunk-writes=true
max-tick-time=60000
enable-command-block=false
enable-query=false
enable-rcon=false
resource-pack=
resource-pack-sha1=
require-resource-pack=false

# Geyser uses a separate UDP port. Configure it in the generated loader-specific Geyser config.
# The default Bedrock port is 19132. Do not share it with another UDP service.
